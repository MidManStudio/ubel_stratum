// tests/fixtures/ok_struct_ownership_dispatch_isolated.ubl
// MEMORY_MODEL.md §9 Open Decision #5, remaining half: does a
// user-defined struct's own extend/impl methods dispatch correctly
// through Unique<T>/Shared<T>/SyncShared<T>, not just the six builtin
// collection kinds ok_ownership_method_dispatch_isolated.ubl already
// covers? Previously TYPE-103/TYPE-104 for all three wrappers, since
// the struct-instance-method branch in type_infer.rs only ever matched
// a bare SemaType::Named, never one still wrapped in an ownership type.
// Expected: sema OK, interpret OK.

struct Counter {
    value: int,
}

extend Counter {
    fn zero() Counter {
        return Counter { value = 0 }
    }

    fn increment(self) void {
        self.value = self.value + 1
    }

    fn increment_and_get(self) int {
        self.value = self.value + 1
        return self.value
    }

    fn get(self) int {
        return self.value
    }
}

@tier(low)
fn main() void {
    // Unique<T> locals are move-tracked, but a call to a user-declared
    // method does not count as a move of its receiver, so several calls
    // in a row are fine.
    let u = Unique.new(Counter.zero())
    u.increment()
    assert(u.increment_and_get() == 2, "instance method dispatches through Unique<Counter>")
    assert(u.get() == 2, "and the receiver is still usable afterwards")

    let s = Shared.new(Counter.zero())
    s.increment()
    let s2 = s
    s2.increment()
    s2.increment()
    assert(s.get() == 3, "instance method dispatches through Shared<Counter>, mutation visible through the alias")

    let sync = SyncShared.new(Counter.zero())
    sync.increment()
    sync.increment()
    assert(sync.get() == 2, "instance method dispatches through SyncShared<Counter>")
}
