// tests/fixtures/err_arena_borrow_shared_lifetime.ubl
// D1 (docs/ARENA_BORROW_RULES.md), rule R2: a named lifetime that appears in two parameters could be handed
// back or stored through either, so it cannot take an arena borrow.
//
// Expected: sema FAIL (ArenaRefEscapesBoundary).

struct Vec2 {
    x: int
    y: int
}

@tier(mid)
fn bigger [lifetime L] (a: &L Vec2, b: &L Vec2) int {
    return a.x + b.x
}

@tier(mid)
fn run(g: Vec2) int {
    with arena(256) {
        let v = Vec2 { x = 3, y = 4 }
        return bigger(&v, &g)
    }
}

fn main() void {
    let g = Vec2 { x = 1, y = 2 }
    println(run(g))
}
