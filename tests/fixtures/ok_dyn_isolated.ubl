// tests/fixtures/ok_dyn_isolated.ubl
// `dyn Shape` on its own: a value of any type that implements the trait, the
// type known only at run time. A list holds a circle and a square, and each
// call on an element runs that element's own impl. A value becomes a `dyn`
// value where a type is written: a `let`, an argument, a return, a struct
// field, an element handed to a collection, an array literal, and `as dyn`.
// A default method of the trait runs through `dyn` as well.
// Expected: sema OK, interpret OK.

trait Shape {
    fn area(self) int
    fn name(self) string

    fn double_area(self) int {
        return self.area() * 2
    }
}

struct Circle {
    r: int,
}

struct Square {
    side: int,
}

impl Shape for Circle {
    fn area(self) int { return 3 * self.r * self.r }
    fn name(self) string { return "circle" }
}

impl Shape for Square {
    fn area(self) int { return self.side * self.side }
    fn name(self) string { return "square" }
}

struct Holder {
    s: dyn Shape,
}

fn total(shapes: List<dyn Shape>) int {
    let mut t = 0
    for s in shapes {
        t = t + s.area()
    }
    return t
}

fn make(k: int) dyn Shape {
    if k == 0 {
        return Circle { r = 1 }
    }
    return Square { side = 2 }
}

fn main() void {
    let shapes: List<dyn Shape> = List.new()
    shapes.push(Circle { r = 2 })
    shapes.push(Square { side = 3 })
    for s in shapes {
        println(s.name())
        println(s.area())
    }
    assert(total(shapes) == 21, "total of a list of dyn")

    let literal: List<dyn Shape> = [Circle { r = 1 }, Square { side = 2 }]
    assert(total(literal) == 7, "an array literal is coerced element by element")

    let one: dyn Shape = Square { side = 4 }
    assert(one.area() == 16, "a written type coerces a single value")
    assert(one.double_area() == 32, "a default method runs through dyn")

    let h = Holder { s = Circle { r = 2 } }
    assert(h.s.area() == 12, "a struct field may be dyn")

    assert(make(0).area() == 3, "a dyn return")
    assert(make(1).area() == 4, "the other branch of the return")

    let d: Dictionary<string, dyn Shape> = Dictionary.new()
    d.set("c", Circle { r = 3 })
    assert(d.get("c").area() == 27, "a dictionary of dyn")

    let o: dyn Shape? = Square { side = 5 }
    assert(o.area() == 25, "an optional dyn")

    let c = Circle { r = 4 } as dyn Shape
    assert(c.area() == 48, "as dyn is a written coercion")
    println("done")
}
