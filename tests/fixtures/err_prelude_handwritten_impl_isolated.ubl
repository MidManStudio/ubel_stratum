// tests/fixtures/err_prelude_handwritten_impl_isolated.ubl
// A hand-written impl of a prelude trait is checked like any trait impl. Here
// each kind of mistake is one diagnostic at the impl: a `@derive` and an impl
// of the same trait (two sources of one impl), an `impl Ord` with no
// `PartialOrd` under it, an `impl PartialEq` with no `eq`, and an `impl
// PartialEq` whose `eq` takes the wrong type.
// Expected: sema FAIL (TYPE-128, TYPE-132, TYPE-123, TYPE-125).

@derive(PartialEq)
struct Twice {
    n: int,
}

impl PartialEq for Twice {
    fn eq(self, other: Twice) bool { return true }
}

struct Ranked {
    n: int,
}

impl Ord for Ranked {
    fn cmp(self, other: Ranked) Ordering { return Ordering.Equal }
}

struct Empty {
    n: int,
}

impl PartialEq for Empty {
}

struct Wrong {
    n: int,
}

impl PartialEq for Wrong {
    fn eq(self, other: int) bool { return true }
}

fn main() void {
    println(1)
}
