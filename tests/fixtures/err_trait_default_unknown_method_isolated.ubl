// tests/fixtures/err_trait_default_unknown_method_isolated.ubl
// Inside a default method `self` is the abstract `Self`, which only has
// the trait's own methods. Calling something the trait does not declare is
// TYPE-104, and the message names `Self`, not an internal generic
// parameter.
// Expected: sema FAIL (NoSuchMethod, TYPE-104).

trait Shape {
    fn area(self) int
    fn bad(self) int { return self.nothing() }
}

struct Sq {
    s: int,
}

impl Shape for Sq { fn area(self) int { return 1 } }

fn main() void {
}
