// tests/fixtures/ok_return_literals_isolated.ubl
// `return` reads a value after every kind of expression start. A double
// literal, a typed integer literal and a built-in collection name used to read
// as a bare `return`, so `return 3.0 * r` returned nothing and the product was
// a dead statement.
// Expected: sema OK, interpret OK.

struct Circle { r: double }

extend Circle {
    fn area(self) double { return 3.0 * self.r * self.r }
}

fn pi_ish() double { return 3.5 }
fn small() u32 { return 5u32 }
fn small_sum() u32 { return 5u32 + 1u32 }
fn words() List<string> { return List.new() }
fn counts() Dictionary<string, int> { return Dictionary.new() }
fn line() Queue<int> { return Queue.new() }
fn pile() Stack<int> { return Stack.new() }
fn fixed() InlineList<int> { return InlineList.new(2) }

fn main() void {
    let c = Circle { r = 2.0 }
    assert(c.area() == 12.0, "a double literal starts the returned expression")
    assert(pi_ish() == 3.5, "a double literal")
    assert(small() == 5u32, "a typed integer literal")
    assert(small_sum() == 6u32, "a typed integer literal then an operator")
    assert(words().len() == 0, "List.new()")
    assert(counts().len() == 0, "Dictionary.new()")
    assert(line().len() == 0, "Queue.new()")
    assert(pile().len() == 0, "Stack.new()")
    assert(fixed().len() == 0, "InlineList.new(2)")
    println("return literals ok")
}
