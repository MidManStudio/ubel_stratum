// tests/fixtures/err_prelude_hash_combined.ubl
// `Hash` misuse together: a `double` given to a `Hash` bound (NaN), a
// struct that derives only `PartialEq` given to one, `hash` called on a value
// whose type has no `Hash`, a dictionary alias used with a `float` key, and a
// hand-written `impl Hash` (not accepted until the runtime dispatch of S2b).
// Expected: sema FAIL (TYPE-126 three times, TYPE-104, TYPE-129).

@derive(PartialEq)
struct Half {
    n: int,
}

struct Bare {
    n: int,
}

impl Hash for Bare {
    fn hash(self, state: Hasher) void { }
}

type Table<K> = Dictionary<K, int>

fn digest<T: Hash>(x: T) u64 {
    let h = Hasher.new()
    x.hash(h)
    return h.finish()
}

fn main() void {
    println(digest(2.5))
    println(digest(Half { n = 1 }))
    let b = Bare { n = 1 }
    b.hash(Hasher.new())
    let t: Table<float> = Dictionary.new()
}
