// tests/fixtures/err_trait_tier_combined.ubl
// Both halves of the rule beside features shipped earlier: a generic impl and
// an impl for a built-in type that write the wrong tier, a prelude impl at
// the wrong tier, a method reached through a supertrait bound (the supertrait
// is HIGH and the caller is MID), a MID trait reached from a LOW function
// through a bound, and a qualified call on a generic struct.
// Expected: sema FAIL (three TIER-016 and three TIER-005).

@tier(mid)
trait Describe {
    fn describe(self) int
}

struct Crate<T> {
    item: T,
}

impl<T> Describe for Crate<T> {
    @tier(high)
    fn describe(self) int {
        return 1
    }
}

impl Describe for int {
    @tier(low)
    fn describe(self) int {
        return self
    }
}

struct Id {
    n: int,
}

impl PartialEq for Id {
    @tier(mid)
    fn eq(self, other: Id) bool {
        return true
    }
}

trait Base {
    fn base(self) int
}

@tier(mid)
trait Derived: Base {
    fn derived(self) int
}

@tier(mid)
fn via_super<T: Derived>(x: T) int {
    return x.base()
}

@tier(low)
fn via_bound<T: Describe>(x: T) int {
    return x.describe()
}

@tier(low)
fn qualified(c: Crate<int>) int {
    return Describe.describe(c)
}

fn main() void {
    println(1)
}
