// tests/fixtures/ok_prelude_ord_bound_isolated.ubl
// `Ord` and `PartialOrd` are prelude traits: no declaration needed. A
// generic function bounded by `Ord` orders integers, strings and a struct
// that derives the whole chain, compares with `>` and with `cmp`, and
// matches on the prelude `Ordering` enum.
// Expected: sema OK, interpret OK.

@derive(PartialEq, Eq, PartialOrd, Ord)
struct Version {
    major: int,
    minor: int,
}

fn largest<T: Ord>(a: T, b: T) T {
    if a > b { return a }
    return b
}

fn describe<T: Ord>(a: T, b: T) string {
    match a.cmp(b) {
        Ordering.Less => { return "less" }
        Ordering.Equal => { return "equal" }
        Ordering.Greater => { return "greater" }
    }
}

fn main() void {
    println(largest(3, 9))
    println(largest("pear", "apple"))
    println(largest(Version { major = 1, minor = 2 }, Version { major = 1, minor = 5 }).minor)
    println(describe(1, 2))
    println(describe("b", "a"))
    println(describe(Version { major = 2, minor = 0 }, Version { major = 2, minor = 0 }))
}
