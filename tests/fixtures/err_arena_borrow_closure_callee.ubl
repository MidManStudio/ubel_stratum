// tests/fixtures/err_arena_borrow_closure_callee.ubl
// D1 (docs/ARENA_BORROW_RULES.md): a closure (or any function-typed value) is not a lending target yet. Its
// body and what it captured are not visible at the call, so only a declared top-level function
// qualifies. Revisit with D2 (does a function type carry a tier), roadmap A7.
//
// Expected: sema FAIL (ArenaRefEscapesBoundary).

struct Vec2 {
    x: int
    y: int
}

@tier(mid)
fn apply(f: fn(&Vec2) int, n: int) int {
    with arena(256) {
        let v = Vec2 { x = n, y = n + 1 }
        return f(&v)
    }
}

fn main() void {
    let k = 10
    println(apply(fn(v: &Vec2) v.x + v.y + k, 5))
}
