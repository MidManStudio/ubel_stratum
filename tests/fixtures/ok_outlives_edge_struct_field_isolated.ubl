// tests/fixtures/ok_outlives_edge_struct_field_isolated.ubl
// Phase E2 + E4 (docs/OUTLIVES_RULES.md), struct-literal construction
// boundary, no arena involved: `p`'s own loan (`&n`) is still live at
// the point it's stored into `Cache`'s reference field, so this must
// NOT fire LIFETIME-004.
//
// Expected: sema OK, zero errors. Full pipeline OK.

edge struct Cache [lifetime L] {
    item: &L int
}

@tier(low)
fn build_while_live() int {
    let n = 42
    let p = &n
    let c = Cache { item = p }
    return *c.item
}

fn main() void {
    let value = build_while_live()
    assert(value == 42, "the field's own loan is still live when it reaches the construction boundary")
}
