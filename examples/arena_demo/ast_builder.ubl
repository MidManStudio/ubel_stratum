// examples/arena_demo/ast_builder.ubl
//
// The "compiler front end written in Ubel" demo, rewritten to RUN. The first version of this
// file was a design sketch and had never been through the front end (it did not parse). This
// one parses, passes sema and runs in the interpreter:
//
//     cargo run --manifest-path crates/llvm_poc/Cargo.toml --release -- interp examples/arena_demo/ast_builder.ubl
//
// It is also the north-star program of the LLVM proof of concept (docs/LLVM_POC.md): the
// native emitter grows toward compiling it, and the interpreter's output is the reference.
// Today the emitter cannot compile it yet. What each part needs, in the order the emitter
// will most likely get there:
//
//   part 2  edge struct, `&L` fields, borrows, field chains, `with arena`: DONE, see
//           crates/llvm_poc/examples/13_edge_arena.ubl (same node shapes and functions)
//   part 1  enums with payloads and `match`: DONE, see crates/llvm_poc/examples/15_enum_basic.ubl;
//           still needed: strings as values, interpolation that builds one, `==` on strings
//   part 3  a non-capturing closure passed to a MID function, returning a string
//
// Tier map (the same split the bootstrap goal has):
//   HIGH  the driver and the pretty-printer: GC-managed enum trees and strings
//   MID   the transient AST: arena-resident nodes that die with the `with arena` block
//   LOW   plain integer helpers, callable from anywhere
//
// What is different from the sketch, and why (all found by running it):
//   - Enums cannot carry arena references and cannot take a lifetime, so the arena AST is
//     built from edge structs with mandatory `&L` fields, one struct per node shape. The
//     recursive tree lives in the HIGH enum. A recursive arena tree needs optional
//     references, and `&L Node?` accepts neither `null` nor any other way to say "none".
//   - Sema rejects passing an arena value as a call argument, so arena nodes are built and
//     read inline in one function. Only plain ints and strings cross a call.
//   - `arena` is a reserved word and there is no `arena.alloc`: a struct literal written
//     inside `with arena(size)` is what allocates from that arena.
//   - Lambdas have no return type annotation; the body after the parameters is the result.
//   - No spans: structs are references in the interpreter, so the sketch's "plain value
//     type, copy freely" `Span` would alias instead of copy.

// ── Part 1 (HIGH): the AST as a recursive enum, with a printer and an evaluator ─────────

enum Expr {
    Num(int),
    Var(string),
    Add(Expr, Expr),
    Mul(Expr, Expr),
    Neg(Expr),
    Call(string, Expr),
}

fn show(e: Expr) string {
    match e {
        Expr.Num(n) => return $"{n}",
        Expr.Var(name) => return name,
        Expr.Add(a, b) => return $"({show(a)} + {show(b)})",
        Expr.Mul(a, b) => return $"({show(a)} * {show(b)})",
        Expr.Neg(a) => return $"-{show(a)}",
        Expr.Call(name, arg) => return $"{name}({show(arg)})",
    }
}

fn apply(name: string, v: int) int {
    if name == "square" {
        return v * v
    }
    if name == "double" {
        return v + v
    }
    return v
}

// `x` is the value every `Var` evaluates to.
fn eval(e: Expr, x: int) int {
    match e {
        Expr.Num(n) => return n,
        Expr.Var(name) => return x,
        Expr.Add(a, b) => return eval(a, x) + eval(b, x),
        Expr.Mul(a, b) => return eval(a, x) * eval(b, x),
        Expr.Neg(a) => return 0 - eval(a, x),
        Expr.Call(name, arg) => return apply(name, eval(arg, x)),
    }
}

// ── Part 2 (MID): the same shape of tree, arena-resident and short-lived ────────────────

edge struct IntNode [lifetime L] {
    value: int
}

edge struct BinNode [lifetime L] {
    op:  int
    lhs: &L IntNode
    rhs: &L IntNode
}

edge struct CallNode [lifetime L] {
    callee: int
    arg:    &L BinNode
}

@tier(low)
fn square(v: int) int {
    return v * v
}

// Builds `square(a + b)` (or `a * b` when `mul` is true) in a fresh arena, evaluates it by
// following the node references, and hands only the result out, through the callback. The
// arena goes away on the way out of the block, taking every node with it.
@tier(mid)
fn build_and_eval(a: int, b: int, mul: bool, cb: fn(int) string) string {
    with arena(64KB) {
        let x = IntNode { value = a }
        let y = IntNode { value = b }
        let bin = BinNode { op = if mul { 1 } else { 0 }, lhs = &x, rhs = &y }
        let call = CallNode { callee = 1, arg = &bin }

        let l = call.arg.lhs.value
        let r = call.arg.rhs.value
        let v = if call.arg.op == 0 { l + r } else { l * r }
        let result = if call.callee == 1 { square(v) } else { v }
        return cb(result)
    }
}

// Many short-lived trees, one arena each: the cost of the arena lifecycle per tree.
@tier(mid)
fn checksum(n: int) int {
    let mut total = 0
    for i in 0 .. n {
        with arena(1KB) {
            let x = IntNode { value = i }
            let y = IntNode { value = i + 1 }
            let bin = BinNode { op = 0, lhs = &x, rhs = &y }
            let call = CallNode { callee = 0, arg = &bin }
            total += call.arg.lhs.value + call.arg.rhs.value
        }
    }
    return total
}

// ── Part 3 (HIGH): the driver. The arena machinery stays out of sight ───────────────────

// Compiles `square(a + b)` two ways and checks that they agree: the enum tree evaluated
// directly, and the arena tree evaluated in MID code, whose result reaches HIGH as a string
// through the callback.
fn compile_expression(a: int, b: int) string {
    let tree = Expr.Call("square", Expr.Add(Expr.Num(a), Expr.Num(b)))
    let direct = eval(tree, 0)
    let via_arena = build_and_eval(a, b, false, fn(v: int) $"{v}")
    let agree = via_arena == $"{direct}"
    return $"{show(tree)} = {via_arena}  (enum tree says {direct}, agree: {agree})"
}

fn main() void {
    println(compile_expression(1, 2))
    println(compile_expression(3, 4))

    // `Var` takes the value of x; `Neg` and `Mul` work on the enum tree too.
    let poly = Expr.Add(Expr.Mul(Expr.Var("x"), Expr.Neg(Expr.Num(3))), Expr.Num(10))
    println($"{show(poly)} at x = 5 is {eval(poly, 5)}")

    // The same tree shape with `*` instead of `+`, through the arena path.
    println(build_and_eval(6, 7, true, fn(v: int) $"6 * 7, squared: {v}"))

    println("checksum:", checksum(1000))
}
