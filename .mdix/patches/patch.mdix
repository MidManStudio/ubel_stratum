// traits S3c: remove the fixture that has nothing left to show.
//
// tests/fixtures/err_bound_unsupported_combined.ubl existed to show the two
// bounds that parsed but could not be enforced yet (a bound on a type alias
// parameter and on a method's own generic parameter, each TYPE-129). Both are
// built in S3c, so the file now checks clean and its header ("sema FAIL")
// is wrong. The new fixtures err_alias_bound_isolated and
// err_method_generic_isolated replace it. A replacements archive cannot
// delete a file, so the removal is this patch.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~delete_file<object>(_path) {
    return { path = _path }
  }
)

@DATA(
  delete_files::
    delete_file("tests/fixtures/err_bound_unsupported_combined.ubl")
)
