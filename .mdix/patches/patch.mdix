// Brought to u by MidManStudio
//
// Docs only, 7 anchored edits in docs/LLVM_ROADMAP.md and docs/GC_RESEARCH.md, which the combined sema
// patch left stale (it has landed: peel_arena_str, TIER-017 and check_closure_call are all on master).
//
// docs/LLVM_ROADMAP.md: the D2, D3 and D5 rows now say what was decided and what is implemented; the
// "Limits" sentence no longer says objects are at most 64 words and globals are not roots (large objects
// and ubel_gc_add_root exist); hardening item 1 (global roots, collect-on-every-allocation mode) is marked
// done. docs/GC_RESEARCH.md: the open question about globals and the "make the collector trustworthy"
// step are updated the same way.
//
// Checked against master f852177: every anchor matches exactly once. Run it with dry_run on first; the
// "patched : N" line must say 7.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }
  ~patch_replace_regex<object>(_path, _pattern, _content) {
    return { path = _path, op = "replace_regex", pattern = _pattern, content = _content }
  }
)

@DATA(
  patch_files::
    patch_replace_text("docs/LLVM_ROADMAP.md", "1. Global roots and a collect-on-every-allocation debug mode run over the whole example suite", "1. DONE (2026-11-04, provisional): global roots (`ubel_gc_add_root`) and a collect-on-every-allocation mode (`UBEL_GC_STRESS=N`, `GC_STRESS=N` for `run_equiv.sh`), run over the whole example suite at 64-bit and 32-bit; a 32-bit false-retention bug was also fixed (docs/LLVM_POC.md, Bugs found)")
    patch_replace_regex("docs/LLVM_ROADMAP.md", "Limits: objects of at most 64 words, globals are not\\s+roots, one thread\\.", "Limits: a global is a root only if its memory is registered (`ubel_gc_add_root`), one thread.")
    patch_replace_text("docs/LLVM_ROADMAP.md", "| Yes, to close the hole above. |", "| DECIDED by the owner (2026-10-31): a closure's tier is the tier of the function it is created in. A function type carries no tier, so only LOW can be checked: a LOW function may call only a closure it created itself (TIER-017); MID and HIGH may call any. In sema and in the emitter, provisional. |")
    patch_replace_text("docs/LLVM_ROADMAP.md", "| Sema half delivered; emitter half is A6. |", "| Both halves are in: the emitter half (A6, A6b) and the sema half (docs/ARENA_STRINGS.md). |")
    patch_replace_text("docs/LLVM_ROADMAP.md", "| By site, like every other literal. |", "| DECIDED by the owner (2026-10-31): a capturing closure's object lives in the arena of its block and dies with it. My reading, not confirmed: in a HIGH function outside any arena the object is a GC object (by site, like a struct literal); MID outside an arena and LOW refuse it. Implemented (A7b), provisional. |")
    patch_replace_regex("docs/GC_RESEARCH.md", "\\(Globals are not roots in the\\s+PoC today\\.\\)", "(Globals are roots only if registered with `ubel_gc_add_root`.)")
    patch_replace_regex("docs/GC_RESEARCH.md", "(2\\. Make the current collector trustworthy: global roots, large objects, stress tests that\\s+collect at awkward points, and a debug mode that collects on every allocation\\.)", "\\g<1> Done 2026-11-04 (provisional): see docs/LLVM_POC.md, Log.")
)
