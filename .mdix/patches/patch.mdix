// Brought to u by MidManStudio
//
// MS0: the module system design record, and the pointers it forces in existing text.
// The new document docs/MODULE_DESIGN.md comes in the tarball module-design-replacements.tar.gz.
// This template only edits existing files (4 anchored edits, each anchor occurs once):
//   docs/MODULE_SYSTEM_IDEAS.md     a pointer to the design record
//   web/site/src/project-status.md  one active-work bullet and two known-gap bullets
//   docs/TRAITS_DESIGN.md           the orphan rule row now points at where it is settled
// No code is touched. Order does not matter: the two deliveries do not overlap.
// Checked on a fresh clone of master fe3865a with the real applier.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }
)

@DATA(
  patch_files::
    patch_replace_text("docs/MODULE_SYSTEM_IDEAS.md", "> differs from the form this document writes.", "> differs from the form this document writes. The decisions of 2026-11-15 are in\n> `docs/MODULE_DESIGN.md`; this document stays as the list of parked ideas.")
    patch_replace_text("web/site/src/project-status.md", "  async core", "  async core\n- Modules (`summon`) are designed and not built (`docs/MODULE_DESIGN.md`, decided 2026-11-15): a\n  module is a file named by its path, cycles between modules are allowed, everything is private\n  unless marked `pub`, impls apply program-wide, and a whole module can set a default tier.\n  Next: single-file fixes for imports and initialization cycles, then multi-file checking")
    patch_replace_text("web/site/src/project-status.md", "`undefined name 'L'` when the program runs", "`undefined name 'L'` when the program runs\n- `from m summon [a as b]` is accepted and imports both `a` and `b` as separate names\n- Constants or statics that depend on each other circularly pass the check and stop with\n  `undefined name` when the program runs")
    patch_replace_text("docs/TRAITS_DESIGN.md", "the package that declares the trait or the type. |", "the package that declares the trait or the type. Settled 2026-11-15 in `docs/MODULE_DESIGN.md` (M2). |")
)
