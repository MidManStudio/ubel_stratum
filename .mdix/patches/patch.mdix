// Brought to u by MidManStudio
//
// Closures in arenas (decision D5). Two defects in crates/core/src/sema/type_infer.rs:
//  1. Calling a closure that was written inside `with arena` failed with "no method `<call>`", because
//     its value is typed `&arena fn(...)` and only plain function types were callable (and the error
//     then panicked the checker, see 2). The call now looks through the arena tag: it only reads the
//     closure, which lives as long as the block. The tag still stops the closure from leaving the block.
//  2. `TypeId::ERROR` (the sentinel for "already reported") reached `apply` and `unify`, which indexed
//     the type table with it and panicked. Both now return early on it, so a sema error stays an error.
// Four anchored edits, no other file. The anchors do not depend on the earlier string patch
// (docs/ARENA_STRINGS.md), so the two can be applied in either order, but each patch.mdix replaces the
// one before it: run the earlier one first (dry_run off), then commit this file over it.
// Run the "Apply Patches" workflow with dry_run on first.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_insert_after<object>(_path, _anchor, _content) {
    return { path = _path, op = "insert_after", anchor = _anchor, content = _content }
  }
  ~patch_insert_before<object>(_path, _anchor, _content) {
    return { path = _path, op = "insert_before", anchor = _anchor, content = _content }
  }
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }
  ~patch_replace_regex<object>(_path, _pattern, _content) {
    return { path = _path, op = "replace_regex", pattern = _pattern, content = _content }
  }
)

@DATA(
  patch_files::
    patch_insert_before("crates/core/src/sema/type_infer.rs", "/// Wrap `inner_ty` as an ArenaRef if inside a `with arena` block.", "    /// D5 (closures): calling a closure that was created inside `with arena` (its value is typed\n    /// `&arena fn(...)`) only reads the closure object, which lives as long as the block, so the call\n    /// is checked against the plain function type. What the call returns keeps whatever tag the\n    /// closure's own result type has.\n    fn peel_closure_tag(&mut self, ty: TypeId) -> TypeId {\n        if let SemaType::ArenaRef { inner, .. } = self.ctx.types.get(ty).clone() {\n            let inner = self.apply(inner);\n            if matches!(self.ctx.types.get(inner), SemaType::Function { .. }) {\n                return inner;\n            }\n        }\n        ty\n    }\n\n")
    patch_replace_regex("crates/core/src/sema/type_infer.rs", "(let callee_def = self\\.fn_type_defs\\.get\\(&resolved\\)\\.copied\\(\\);\\s*)match self\\.ctx\\.types\\.get\\(resolved\\)\\.clone\\(\\) \\{", "\\g<1>let callee_shape = self.peel_closure_tag(resolved);\n        match self.ctx.types.get(callee_shape).clone() {")
    patch_replace_regex("crates/core/src/sema/type_infer.rs", "(fn apply\\(&self, mut id: TypeId, types: &crate::sema::type_table::TypeTable\\) -> TypeId \\{\\s*loop \\{\\s*)match types\\.get\\(id\\) \\{", "\\g<1>if id.is_error() { return id; }\n            match types.get(id) {")
    patch_insert_after("crates/core/src/sema/type_infer.rs", "fn unify(&mut self, a: TypeId, b: TypeId, span: Span) {", "        // The error sentinel: the problem was reported where it arose.\n        if a.is_error() || b.is_error() { return; }\n")
)
