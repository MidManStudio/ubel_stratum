// Brought to u by MidManStudio
//
// Sema: `xs.push(v)` on a list whose element type nothing has fixed yet (`let xs = List.new()`) fixes the element type to
// the type of `v`. Anchored edits in crates/core/src/sema/ (type_infer.rs: one call in the builtin-method path and one new
// method, bind_list_elem_from_push, placed before finish_int_literals; tests.rs: one regression test), and docs/LLVM_POC.md (a log entry and the resolved finding).
// Each anchor occurs exactly once and none is a whole line. This overwrites the earlier patch.mdix, which is right: there
// is only ever one (the earlier one, the docs patch for ztail-14, is applied on master).
// Order: apply the tarball ubel-llvm-zlangbench-15.tar.gz first (it re-aims example u_list_untyped, which this patch would
// otherwise make compile), then this patch.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }
)

@DATA(
  patch_files::
    patch_replace_text("crates/core/src/sema/type_infer.rs", "self.check_dyn_element_arg(kind, field, bare_ty, args);\n\n                            // A key handed to a dictionary whose own key type is", "self.check_dyn_element_arg(kind, field, bare_ty, args);\n\n                            // `xs.push(v)` on a list whose element type nothing has fixed yet\n                            // (`let xs = List.new()`) fixes it to the type of `v`.\n                            if kind == instance::ReceiverKind::List && field == \"push\" {\n                                self.bind_list_elem_from_push(bare_ty, args);\n                            }\n\n                            // A key handed to a dictionary whose own key type is")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "    fn finish_int_literals(&mut self) {\n        let sites = std::mem::take(&mut self.int_lit_sites);\n", "    /// `xs.push(v)` on a list whose element type nothing has fixed yet (`let xs = List.new()`): the element type\n    /// becomes the type of `v`. A list whose element type is already known (an annotation, an earlier push) is left\n    /// alone, so nothing that was accepted before is rejected now, and so is a pushed value of unknown type.\n    fn bind_list_elem_from_push(&mut self, list_ty: TypeId, args: &[Arg]) {\n        let SemaType::List(elem) = self.ctx.types.get(list_ty).clone() else { return };\n        let elem = self.apply(elem);\n        if !matches!(self.ctx.types.get(elem), SemaType::Var(_)) || self.int_lit_var_of(elem).is_some() {\n            return;\n        }\n        let Some(arg) = args.first() else { return };\n        let sp = match &arg.kind {\n            ArgKind::Positional(e)       => e.span,\n            ArgKind::Named { value, .. } => value.span,\n        };\n        let Some(arg_ty) = self.ctx.expr_type(sp) else { return };\n        let arg_ty = self.apply(arg_ty);\n        if arg_ty.is_error() || matches!(self.ctx.types.get(arg_ty), SemaType::Unknown) {\n            return;\n        }\n        self.unify(elem, arg_ty, sp);\n    }\n\n    fn finish_int_literals(&mut self) {\n        let sites = std::mem::take(&mut self.int_lit_sites);\n")
    patch_replace_text("crates/core/src/sema/tests.rs", "        other => panic!(\"expected SemaType::List, got {:?}\", other),\n    }\n}\n", "        other => panic!(\"expected SemaType::List, got {:?}\", other),\n    }\n}\n\n\n// -- push fixes the element type of an untyped list --\n\n#[test]\nfn test_sema_push_fixes_the_element_type_of_an_untyped_list() {\n    // fn foo() { let xs = List.new(); xs.push(1) }\n    // Nothing fixes the element type of `xs` but the push; the type recorded for `List.new()` must end up `List<int>`\n    // (the native backend reads it; before, the element stayed an unbound variable).\n    let arena = AstArena::new();\n    const CALL_SPAN: Span = Span { start: 1, end: 1, line: 0, column: 0 };\n    const LET_SPAN:  Span = Span { start: 2, end: 2, line: 0, column: 0 };\n    const XS_SPAN:   Span = Span { start: 3, end: 3, line: 0, column: 0 };\n    const ARG_SPAN:  Span = Span { start: 4, end: 4, line: 0, column: 0 };\n    const PUSH_SPAN: Span = Span { start: 5, end: 5, line: 0, column: 0 };\n\n    let call = builtin_ctor_call(&arena, \"List\", CALL_SPAN);\n    let let_xs = Stmt {\n        kind: StmtKind::Let {\n            mutable: false,\n            binding: BindingTarget::Ident(arena.alloc_str(\"xs\")),\n            ty:      None,\n            value:   call,\n        },\n        span: LET_SPAN,\n    };\n    let target = arena.alloc(Expr { kind: ExprKind::Ident(arena.alloc_str(\"xs\")), span: XS_SPAN });\n    let callee = arena.alloc(Expr { kind: ExprKind::Field { target, field: \"push\" }, span: Z });\n    let one    = arena.alloc(Expr { kind: ExprKind::Lit(Literal::Int(1)), span: ARG_SPAN });\n    let args: &[Arg] = arena.alloc_slice_copy(&[Arg { kind: ArgKind::Positional(one), span: Z }]);\n    let push = Stmt {\n        kind: StmtKind::Expr(arena.alloc(Expr { kind: ExprKind::Call { callee, args }, span: PUSH_SPAN })),\n        span: Z,\n    };\n    let stmts = arena.alloc_slice_copy(&[let_xs, push]);\n    let f     = make_fn(&arena, \"foo\", Block { stmts, span: Z });\n\n    let prog = prog_with(&arena, &[Item::Function(f)]);\n    let ctx  = sema::analyse(&prog, &arena, String::new())\n        .expect(\"sema should accept an untyped List.new() followed by a push\");\n\n    let ty_id = ctx.expr_type(CALL_SPAN).expect(\"List.new() should have an inferred type\");\n    match ctx.types.get(ty_id) {\n        SemaType::List(elem) => match ctx.types.get(*elem) {\n            SemaType::Int => {}\n            other => panic!(\"expected List<int> after the push, got an element of {:?}\", other),\n        },\n        other => panic!(\"expected SemaType::List, got {:?}\", other),\n    }\n}\n")
    patch_replace_text("docs/LLVM_POC.md", "- 2026-11-21 (chat 9): **Tail values, and the first cross-language benchmarks.**", "- 2026-11-22 (chat 9): **Benchmarks by memory tier, a workflow to run them, and sema binds the element type from `push`.** `crates/ubel_llvm/langbench/` now has four tracks (`tracks.txt`): `compute` (n-body, spectral-norm, fannkuch-redux: Ubel, C, Rust, C#, Go), `gc` (binary-trees: Ubel HIGH against C# and Go), `arena` (binary-trees with every tree in an arena: Ubel MID against Zig, Odin and Rust) and `manual` (binary-trees with `malloc`/`free`, `new`/`delete` or `Box`: Ubel LOW against C, C++ and Rust). `run.sh` builds every language, checks every output against one expected output, times best of N (optionally pinned to one core with `--pin`), and writes `summary.md`, `results.tsv` and `status.tsv`; a language or tier that cannot run is a row with the reason instead of a failure (Ubel MID shows the emitter's refusal, Ubel LOW has no program yet). `install_tools.sh` installs the toolchains on Ubuntu (Zig 0.13 from PyPI, Odin from the GitHub release). The workflow `.github/workflows/langbench.yml` (uploaded by hand) runs it on a hosted runner, once with all cores and once pinned to one, and puts the tables on the run summary. First numbers are in `langbench/LANGBENCH.md`: on a shared one-core VM, best of 5, Ubel HIGH is about 1.14x C# and well ahead of Go on binary-trees, Zig and Rust are level on the arena program, Odin is about 1.8x (about 5x with its virtual-memory arena, which locks per allocation and zeroes on `free_all`), and the compute geometric mean is 1.22x of the fastest for Ubel. Sema now binds the element type of an untyped list from the first `push` (decided 2026-11-22): `bind_list_elem_from_push` in `type_infer.rs`, only when the element type is still an unbound variable, so nothing accepted before is rejected; `ok_imports` now builds natively and equals the interpreter, 32 of the 199 `ok_` fixtures build (31 before), `ok_collections_high` and `ok_linqerizer_group_by` move on to Dictionary, and `ok_import_std_isolated` stays refused because its pushed value (`sqrt(9)`) has no type sema knows. Example `u_list_untyped` was re-aimed at a list that is never pushed to, which is refused with and without the patch. Checked on fresh clones of master `2f2bb72` with the real applier: with the tarball alone the cargo tests pass (`ubel_llvm` 6 + 19, core 231), `run_ubel_build.sh` gives 68 supported programs, 56 intentional refusals, 31 `ok_` built and 168 refused, `run_equiv.sh` 131 passed, 0 failed, and `langbench` prints the expected output in every language that is installed here; with the sema patch added (core 232 tests, including the new regression test, which fails without the call) 32 `ok_` built and 167 refused, and `run_equiv.sh` 131 passed, 0 failed at 64-bit and at -m32. Not verified: the workflow has never run on a GitHub runner (it passes actionlint, and `install_tools.sh` was run from a clean environment in the sandbox but not on a hosted runner), `run.sh` on macOS or Termux, ARM, the effect of pinning on a hosted runner, Zig or Odin versions other than 0.13 and dev-2026-11. Delivery note: cargo can treat a freshly cloned tree as up to date when its files are older than a build already in a shared target directory, so a verification clone built into a shared target must have its sources touched first (a chain of mine silently tested the wrong sources once because of this).\n- 2026-11-21 (chat 9): **Tail values, and the first cross-language benchmarks.**")
    patch_replace_text("docs/LLVM_POC.md", "or the emitter infers it from the first push (no language change). Open.", "or the emitter infers it from the first push (no language change). Decided by the owner on 2026-11-22: sema binds it (see the Log entry of that date).")
)
