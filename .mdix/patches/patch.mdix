// Brought to u by MidManStudio
//
// LLVM proof of concept, Stage 0: bring the status docs up to date.
//
// Three one-line edits, each anchored on the exact text it replaces, so they
// cannot overwrite anything else in these files. Apply with the "Apply Patches"
// workflow. This file replaces the previous patch.mdix, whose only job (the
// traits S3c fixture removal) has already been applied.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }
)

@DATA(
  patch_files::
    patch_replace_text("web/site/src/project-status.md", "| 4 | Not started | LLVM backend, native binaries |", "| 4 | Started | LLVM backend, native binaries. So far only a measurement proof of concept: hand-written IR for the three tiers, nothing generated from Ubel source yet (`docs/LLVM_POC.md`) |")
    patch_replace_text("web/site/src/introduction.md", "| 4 | Not started | LLVM backend, native binaries |", "| 4 | Started | LLVM backend, native binaries. So far only a measurement proof of concept: hand-written IR for the three tiers, nothing generated from Ubel source yet (`docs/LLVM_POC.md`) |")
    patch_replace_text("CONTRIBUTING.md", "with the LLVM backend not yet started, see", "with only a measurement proof of concept of the LLVM backend so far, see docs/LLVM_POC.md and")
)
