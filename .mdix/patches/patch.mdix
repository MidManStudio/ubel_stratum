// Brought to u by MidManStudio
//
// D3b (roadmap): an interpolated string written inside `with arena` is an arena value, so sema
// refuses to let it outlive the block; `==`, `<` and `+` still read it. Rules and reasoning:
// docs/ARENA_STRINGS.md. One code file, crates/core/src/sema/type_infer.rs, three anchored edits
// (one new helper, one line in the interpolation literal arm, one line at the top of
// binop_result), plus one line in docs/LLVM_ROADMAP.md. Each anchor is unique today; if the traits
// chat has moved any of them, that op prints an error and is skipped, so nothing is overwritten
// silently. Run the "Apply Patches" workflow with dry_run on first.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_insert_after<object>(_path, _anchor, _content) {
    return { path = _path, op = "insert_after", anchor = _anchor, content = _content }
  }
  ~patch_insert_before<object>(_path, _anchor, _content) {
    return { path = _path, op = "insert_before", anchor = _anchor, content = _content }
  }
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }
  ~patch_replace_regex<object>(_path, _pattern, _content) {
    return { path = _path, op = "replace_regex", pattern = _pattern, content = _content }
  }
)

@DATA(
  patch_files::
    patch_insert_before("crates/core/src/sema/type_infer.rs", "/// Wrap `inner_ty` as an ArenaRef if inside a `with arena` block.", "    /// D3b (docs/ARENA_STRINGS.md): if `ty` is an arena-tagged string (`&arena string`), the plain\n    /// string type; any other type comes back unchanged. For an operator that only reads its string\n    /// operands (`==`, `<`, `+`): the result is a `bool`, or a new string that is always allocated in\n    /// the GC heap (a copy), so it carries no borrow of the operand.\n    fn peel_arena_str(&mut self, ty: TypeId) -> TypeId {\n        let resolved = self.apply(ty);\n        if let SemaType::ArenaRef { inner, .. } = self.ctx.types.get(resolved).clone() {\n            let inner = self.apply(inner);\n            if matches!(self.ctx.types.get(inner), SemaType::Str) {\n                return inner;\n            }\n        }\n        ty\n    }\n\n")
    patch_replace_regex("crates/core/src/sema/type_infer.rs", "(self\\.check_format_spec\\(spec, hole_ty, expr\\.span\\);\\s*\\}\\s*\\}\\s*\\}\\s*)self\\.ctx\\.types\\.intern\\(SemaType::Str\\)", "\\g<1>// D3b: an interpolated string is allocated where it is written (docs/ARENA_STRINGS.md).\n                let str_ty = self.ctx.types.intern(SemaType::Str);\n                self.maybe_arena_ref(str_ty)")
    patch_insert_after("crates/core/src/sema/type_infer.rs", "fn binop_result(&mut self, op: BinOp, lhs: TypeId, rhs: TypeId, span: Span) -> TypeId {", "        let (lhs, rhs) = (self.peel_arena_str(lhs), self.peel_arena_str(rhs));\n")
    patch_replace_text("docs/LLVM_ROADMAP.md", "interpolation allocates by site | A6 | As stated. |", "interpolation allocates by site. DECIDED as D3b (chat 4): sema tracks arena strings, a run-time `+` always allocates in the GC heap, see docs/ARENA_STRINGS.md | A6 | Sema half delivered; emitter half is A6. |")
)
