// Brought to u by MidManStudio
//
// AS4a, the Send and Sync marker traits. 31 anchored edits over 14 files: the type inference
// pass (crates/core/src/sema/type_infer.rs, which the LLVM chat also moves, so it is edited and not
// replaced), the async design record, parked ideas, the parser rules, the grammar, the core and parser
// docs, the diagnostics registry, the site error pages, the async guide, project status and the README.
// The other code is in the tarball as4a-markers-replacements.tar.gz. Each anchor occurs exactly once in
// the files as they are on master and none is a whole line. This overwrites the earlier patch.mdix, which
// is right: there is only ever one.

@CONFIG(
  version    -> "1.0.0",
  author     -> "MidManStudio",
  features   -> "quickfuncs,data",
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }
)

@DATA(
  patch_files::
    patch_replace_text("crates/core/src/sema/type_infer.rs", "mod dyn_trait;\nmod builtin_ops;\n", "mod dyn_trait;\nmod builtin_ops;\nmod marker_traits;\n")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "    iterator_trait:   Option<DefId>,\n    /// The prelude's operator traits", "    iterator_trait:   Option<DefId>,\n    /// The prelude's `Send` and `Sync` by definition, and back by name (AS4a). They are marker\n    /// traits with no methods and rules of their own (`marker_status`), so like `Iterator`\n    /// they stay out of `prelude_traits`. Present only for one the program did not shadow.\n    marker_traits:    HashMap<DefId, &'static str>,\n    marker_defs:      HashMap<&'static str, DefId>,\n    /// The prelude's operator traits")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "            iterator_trait:    None,\n            operator_traits:   HashMap::new(),\n", "            iterator_trait:    None,\n            marker_traits:     HashMap::new(),\n            marker_defs:       HashMap::new(),\n            operator_traits:   HashMap::new(),\n")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "                self.iterator_trait = self.ctx.top_level_def(t.name);\n                continue;\n            }\n", "                self.iterator_trait = self.ctx.top_level_def(t.name);\n                continue;\n            }\n            if t.name == \"Send\" || t.name == \"Sync\" {\n                if let Some(def_id) = self.ctx.top_level_def(t.name) {\n                    let name: &'static str = if t.name == \"Send\" { \"Send\" } else { \"Sync\" };\n                    self.marker_traits.insert(def_id, name);\n                    self.marker_defs.insert(name, def_id);\n                }\n                continue;\n            }\n")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "    fn bound_status(&mut self, ty: TypeId, trait_def: DefId) -> Option<bool> {\n        let ty = self.peel_wrappers(ty);", "    fn bound_status(&mut self, ty: TypeId, trait_def: DefId) -> Option<bool> {\n        // `Send` and `Sync` are about where a value lives, so no wrapper is peeled first.\n        if let Some(name) = self.marker_traits.get(&trait_def).copied() {\n            return self.marker_status(name, ty);\n        }\n        let ty = self.peel_wrappers(ty);")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "        // The prelude's `Iterator<T>` is what a `for` loop calls on a struct or\n        // an enum. A built-in type is walked by the loop itself, so an impl\n", "        // `Send` and `Sync` of a built-in type are what its parts are: no impl can change that.\n        if self.marker_traits.contains_key(&trait_def) {\n            let builtin_target = pattern.is_some_and(|p| p.builtin)\n                || (pattern.is_none() && self.builtin_target(i.target_type).is_some());\n            if builtin_target {\n                self.report_unsupported(marker_traits::MARKER_ON_BUILTIN, i.span);\n                return;\n            }\n        }\n        // The prelude's `Iterator<T>` is what a `for` loop calls on a struct or\n        // an enum. A built-in type is walked by the loop itself, so an impl\n")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "        if !self.reported_obligations.insert((span, trait_def)) { return; }\n        let ty = self.peel_wrappers(ty);", "        if !self.reported_obligations.insert((span, trait_def)) { return; }\n        // A marker is about where a value lives, so the type is named as written: `Shared<int>`,\n        // not the `int` inside it.\n        let ty = if self.marker_traits.contains_key(&trait_def) { self.apply(ty) } else { self.peel_wrappers(ty) };")
    patch_replace_text("crates/core/src/sema/type_infer.rs", "        self.check_impl_supertraits();\n        // `dyn` types written before their trait was collected.", "        self.check_impl_supertraits();\n        self.check_marker_impls(program);\n        // `dyn` types written before their trait was collected.")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "the executor when AS3b landed, 2026-11-21)", "the executor when AS3b landed, 2026-11-21, the marker traits when AS4a landed, 2026-11-24)")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "and the worker count is a setting (AS3b, 2026-11-21). No `Mutex`", "and the worker count is a setting (AS3b, 2026-11-21). `Send` and `Sync` exist as marker traits\n  that a type takes with a checked impl, and nothing uses them at `Task.spawn` yet (AS4a,\n  2026-11-24). No `Mutex`")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "`int`, `bool`, `double`, immutable `string`, enum without payload | copy |", "`int`, `bool`, `double`, `char`, immutable `string`, the prelude's `Ordering` | copy |")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "Struct, tuple, enum with payload, `List`, `Dictionary`, `Queue`, `Stack`, `Set`, `InlineList` of sendable parts (HIGH) | deep copy at the boundary |", "A struct or an enum with an `impl Send`; a tuple, array, optional, `List`, `Dictionary`, `Queue`, `Stack`, `Set`, `InlineList` of sendable parts (HIGH) | deep copy at the boundary |")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "Copy at the boundary means a task never sees later mutations", "AS4a (2026-11-24) built the rule as two marker traits, `Send` and `Sync`; \"AS4 decisions\" in\nsection 0 says what has each. Enforcing it at `Task.spawn` is AS4b. Until then a closure, a\n`Shared`, a task or a pool is still refused when the task starts, naming its kind.\n\nCopy at the boundary means a task never sees later mutations")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "It is open whether an `impl Send` is checked against the fields or\ntrusted. A checked one adds only the opt-in. A trusted one lets a struct that holds a `Shared<T>` be\ndeclared sendable, which is a data race the compiler cannot see.", "Decided 2026-11-24: an `impl Send` is checked against the fields\n(`TYPE-145`), and an `unsafe impl Send` is trusted. The checked impl adds only the opt-in. The\ntrusted one lets a struct that holds a `Shared<T>` be declared sendable, which is a data race the\ncompiler cannot see; it can be found by searching for `unsafe impl`.")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "### AS3b decisions (2026-11-21)\n\n- Decided with the user: the executor interface", "### AS4 decisions (2026-11-24)\n\n- Decided with the user:\n  - An `impl Send` or `impl Sync` is checked against the fields of its type, and a separate\n    `unsafe impl Send` is trusted (the open question of the AS3 round). This is against the\n    recommendation, which was checked only. The cost is the one recorded in section 3: a trusted\n    impl can declare a struct that holds a `Shared<T>` sendable, a data race the compiler cannot\n    see. It is written `unsafe impl`, so it can be found by searching.\n  - Sema knows that a task is sendable through a send flag on the task type, computed where the\n    task is built (an async call or an `async {}` block). `Task.spawn` accepts only a sendable task,\n    and a task that is only awaited needs no `Send` (as recommended). This is AS4b.\n  - A `SyncShared<T>` takes its lock for each access until the AS5 lock types exist, and a compound\n    assignment such as `s.n += 1` is one locked step (as recommended). `s.n = s.n + 1` is two locks\n    and can lose an update. This is AS4c.\n- AS4 is delivered in three slices: AS4a the marker traits, `unsafe impl` and the checked impls;\n  AS4b the send flag and the `Task.spawn` check; AS4c the real `SyncShared`, with `TIER-014` lifted\n  for it.\n- Settled without a question in AS4a:\n  - `Send` and `Sync` are prelude traits with no methods (`@tier(low)`, in `prelude.rs`). They are\n    not in the derive list: `@derive(Send)` is `TYPE-116`.\n  - `unsafe impl` is a new item form (`ImplBlock::is_unsafe`). It is accepted for `Send` and `Sync`\n    only: an `unsafe impl` of any other trait, or of no trait, is `TYPE-146`. It is allowed in every\n    tier.\n  - A plain impl is checked against every field of a struct and every payload of every variant of\n    an enum (`TYPE-145`), under the conditions the impl wrote on its parameters. Only the first\n    failing part is named. A trusted impl is not checked.\n  - A built-in type has both markers when its parts do, and no impl is accepted for one\n    (`TYPE-129`), trusted or not. Numbers, `bool`, `char` and `string` have both. A tuple, an array,\n    an optional, a fallible, a `List`, `Set`, `Queue`, `Stack`, `InlineList` and `Dictionary` have a\n    marker when every part has it, `Sync` included. `Unique<T>` has what `T` has. `SyncShared<T>`\n    has both when `T` is `Send`.\n  - `Shared<T>`, every reference and ownership handle (`GcRef`, `ArenaRef`, `PoolRef`, `OwnedRef`),\n    a borrowed view, a pool, a query, a function value and a task have neither. A function value is\n    refused although a declared function can be sent at run time today, because sema cannot tell a\n    declared function from a lambda (parked).\n  - A user enum with no payload needs an impl like any other type, so the row of section 2.3 that\n    treated it as copy is rewritten. The prelude's own `Ordering` has both without one.\n  - A bound `T: Send` is read before wrappers are peeled, unlike the other prelude traits: a\n    `Shared<int>` is not `Send` although its contents are, and the error names the type as written.\n  - A program that declares its own trait called `Send` or `Sync` keeps it as an ordinary trait,\n    as with every prelude name.\n- Known gaps, recorded in `docs/PARKED_IDEAS.md`: a function value is refused by sema but not by\n  the run-time boundary, `Sync` for a collection follows its elements, and no tool lists the\n  `unsafe impl`s of a program.\n\n### AS3b decisions (2026-11-21)\n\n- Decided with the user: the executor interface")
    patch_replace_text("docs/ASYNC_SYNC_DESIGN.md", "**AS4** | The sendable rule: explicit `Send` and `Sync` impls, the sema pass, a real `SyncShared`, `TIER-014` lifted for it. | AS3 |", "**AS4a** | **Done 2026-11-24.** `Send` and `Sync` as prelude marker traits, `unsafe impl`, impls checked against the fields (`TYPE-145`, `TYPE-146`), the rules for built-in types. | AS3 |\n| **AS4b** | The send flag on the task type and the `Task.spawn` check, so that a value that is not sendable is a compile error. | AS4a |\n| **AS4c** | A real `SyncShared`: a lock for each access, `TIER-014` lifted for it. | AS4a |")
    patch_replace_text("docs/PARKED_IDEAS.md", "How its runtime lends threads is part of AS8.\n\n## Built\n", "How its runtime lends threads is part of AS8.\n\n## Found while building AS4a (parked)\n\n- A function value is not `Send` to sema, but a function declared in the program can be sent at run\n  time today (a lambda cannot). Sema cannot tell the two apart from the type alone, so AS4b has to\n  decide whether a declared function gets a type or a flag of its own, or whether a function value\n  stays refused. No program is affected yet, because nothing enforces `Send`.\n- `Sync` for a collection follows its elements, which assumes that a shared view of a collection is\n  read only. That holds for a borrow at LOW. Whether it holds for a shared handle at HIGH is for AS6\n  (scopes), where `Sync` is first used.\n- A user enum with no payload needs `impl Send` like any other type. The prelude's `Ordering` is the\n  one type that has both markers without an impl. A shortcut for plain data was not added.\n- `unsafe impl` is accepted in every tier, and no tool lists the trusted impls of a program. An\n  `ubel` command or a lint that lists every `unsafe impl` would make them easy to audit.\n- A marker impl is reported at the impl and names the field in the text. The span of the field\n  itself is not used.\n\n## Built\n")
    patch_replace_text("docs/PARSER_RULES.md", "interpreter's; the parser reads an ordinary call.\n\n### 5.8 `{` after a bare identifier", "interpreter's; the parser reads an ordinary call.\n\n### 5.7e `unsafe impl`\n\n`unsafe` at item level can only start an impl. `parse_decl` routes `TokenType::Unsafe` to\n`parse_unsafe_impl`, which consumes the keyword and requires `impl` next (anything else is an error\nat that token, followed by `recover_to_decl`). It then parses the block with `parse_impl_block` and\nsets `ImplBlock::is_unsafe`; the span of the block starts at `unsafe`. Attributes before it belong\nto the impl as usual. Whether the trait may be unsafe is not the parser's question: `Send` and\n`Sync` take an `unsafe impl`, and every other one is `TYPE-146` in sema. `unsafe { }` as a statement\nor an expression is unchanged (`parse_unsafe_block`).\n\n### 5.8 `{` after a bare identifier")
    patch_replace_text("docs/ubel.ebnf", "(* ── Impl ── *)\nImplBlock     ::= \"impl\" GenericParams?", "(* ── Impl ── *)\n(* `unsafe` is for the prelude's `Send` and `Sync` only (TYPE-146 otherwise): a trusted impl\n   that is not checked against the fields. See docs/ASYNC_SYNC_DESIGN.md, AS4a. *)\nImplBlock     ::= \"unsafe\"? \"impl\" GenericParams?")
    patch_replace_text("web/site/src/reference/grammar.md", "(* ── Impl ── *)\nImplBlock     ::= \"impl\" GenericParams?", "(* ── Impl ── *)\n(* `unsafe` is for the prelude's `Send` and `Sync` only (TYPE-146 otherwise): a trusted impl\n   that is not checked against the fields. See docs/ASYNC_SYNC_DESIGN.md, AS4a. *)\nImplBlock     ::= \"unsafe\"? \"impl\" GenericParams?")
    patch_replace_text("docs/ubel_stratum.md", "as `trait_args`\n  (`impl Convert<int> for X`).", "as `trait_args`\n  (`impl Convert<int> for X`). `ImplBlock.is_unsafe` is set by `unsafe impl` (AS4a).")
    patch_replace_text("docs/ubel_stratum.md", "infers expression types, and checks function signatures against call\nsites.\n", "infers expression types, and checks function signatures against call\nsites.\n\n`sema/type_infer/marker_traits.rs` (AS4a) holds the rules of `Send` and `Sync`:\n`marker_status` says whether a type has a marker (`bound_status` asks it before any wrapper is\npeeled), and `check_marker_impls` checks every `impl Send` and `impl Sync` against the fields of\nits type (`TYPE-145`) and every `unsafe impl` against the traits that may be unsafe\n(`TYPE-146`). `crates/rd_parser/tests/send_sync_markers.rs` covers them.\n")
    patch_replace_text("docs/ubel_stratum_rd.md", "`Clone`, `Display`, `Dispose`, `Iterator`, the twelve operator traits", "`Clone`, `Display`, `Dispose`, `Send`, `Sync`, `Iterator`, the twelve operator traits")
    patch_replace_text("docs/ubel_stratum_rd.md", "and `tests/using_cleanup.rs` covers it.", "and `tests/using_cleanup.rs` covers it. `Send` and `Sync` are marker traits with no methods, and\n`tests/send_sync_markers.rs` covers them.")
    patch_replace_text("docs/DIAGNOSTICS_RULES.md", "TYPE-144 | AsyncReturnNotTask |", "TYPE-144 | AsyncReturnNotTask |\n| TYPE-145 | MarkerImplField |\n| TYPE-146 | UnsafeImplNotMarker |")
    patch_replace_text("docs/DIAGNOSTICS_RULES.md", "at the signature. No suggestion.\n\n**TIER-0xx**", "at the signature. No suggestion.\n- `TYPE-145` `MarkerImplField` — *Error*. \"`impl Send for Holder`: field `cell` has type `Shared<int>`, which is not `Send`\". An `impl Send` or `impl Sync` for a struct or an enum where a field of the struct, or a positional or named field of a variant, has a type without that marker (`marker_status`). Raised by `check_marker_impls` once the impls are registered, at the impl. An impl for a generic type is read in its own scope, so a `T` has the marker only through a bound the impl wrote. Only the first failing part is named, as `field `x``, `field 0 of variant `V`` or `field `x` of variant `V``. An `unsafe impl` is not checked, and an impl that registration refused (`TYPE-128`, `TYPE-129`) is not checked again. Suggestion: \"give the field a type that is `Send`, or, if the type is sound to use that way, write `unsafe impl Send for ...` (trusted, not checked)\".\n- `TYPE-146` `UnsafeImplNotMarker` — *Error*. \"`unsafe impl` is only for `Send` and `Sync`, found an impl of `Show`\" (or \"found an inherent impl\"). An `unsafe impl` of any trait but the prelude's `Send` or `Sync`, or of no trait. A program that declares its own `Send` keeps it as an ordinary trait, so an `unsafe impl` of it is this error. The impl is still read as an ordinary impl. Raised by `check_marker_impls`. Suggestion: \"drop `unsafe`: an impl of any other trait is checked like every impl\".\n\n**TIER-0xx**")
    patch_replace_text("web/site/src/errors/index.md", "type-144) | AsyncReturnNotTask |", "type-144) | AsyncReturnNotTask |\n| [TYPE-145](./type.md#type-145) | MarkerImplField |\n| [TYPE-146](./type.md#type-146) | UnsafeImplNotMarker |")
    patch_replace_text("web/site/src/errors/type.md", "Declare the task: `async fn count() Task<int>`. The body still returns the `int`.", "Declare the task: `async fn count() Task<int>`. The body still returns the `int`.\n\n### TYPE-145\n\n**MarkerImplField** — `` `impl Send for Holder`: field `cell` has type `Shared<int>`, which is not `Send` ``\n\nAn `impl Send` or an `impl Sync` for a struct or an enum where a field, or the payload of a variant, has a type without that marker. The impl is checked against every field of a struct and every payload of every variant of an enum, under the conditions the impl wrote on its type parameters, and only the first part that fails is named. `Shared<T>`, references, borrowed views, function values and tasks have neither marker, and a struct or an enum has one only through an impl of its own. An `unsafe impl` is not checked.\n\n<!-- ubel-test: error TYPE-145 -->\n```ubel\nstruct Holder { cell: Shared<int> }\n\nimpl Send for Holder {\n}\n\nfn main() {\n}\n```\n\n```text\n>>> error[TYPE-145]: `impl Send for Holder`: field `cell` has type `Shared<int>`, which is not `Send`\n  --> 3:1\n    |\n  3 | impl Send for Holder {\n    | ^^^^^^^^^^^^^^^^^^^^^^\n  ~> help: give the field a type that is `Send`, or, if the type is sound to use that way, write `unsafe impl Send for ...` (trusted, not checked)\n  <~\n<<<\n```\n\n**Fix:** Give the field a type that is `Send`. If the type is sound to use that way in spite of what the compiler can see, write `unsafe impl Send for Holder {}`, which is trusted and not checked.\n\n### TYPE-146\n\n**UnsafeImplNotMarker** — `` `unsafe impl` is only for `Send` and `Sync`, found an inherent impl ``\n\nAn `unsafe impl` of anything but the prelude's `Send` or `Sync`: an impl of another trait, or an impl with no trait. The impl is still read as an ordinary impl, so only the keyword is reported.\n\n<!-- ubel-test: error TYPE-146 -->\n```ubel\nstruct Gauge { reading: int }\n\nunsafe impl Gauge {\n    fn read(self) int { return self.reading }\n}\n\nfn main() {\n}\n```\n\n```text\n>>> error[TYPE-146]: `unsafe impl` is only for `Send` and `Sync`, found an inherent impl\n  --> 3:1\n    |\n  3 | unsafe impl Gauge {\n    | ^^^^^^^^^^^^^^^^^^^\n  ~> help: drop `unsafe`: an impl of any other trait is checked like every impl\n  <~\n<<<\n```\n\n**Fix:** Drop `unsafe`. An impl of any other trait is checked like every impl.")
    patch_replace_text("web/site/src/guide/async.md", "needs at least 128 MiB of stack, which the runtime cannot check.\n\n## The decided design", "needs at least 128 MiB of stack, which the runtime cannot check.\n\n### Send and Sync\n\nA value can go into a task only when its type is `Send`, and a task can use a shared view of a value\nonly when its type is `Sync`. Both are traits with no methods. A struct or an enum has one only when\nit says so with an `impl`, and nothing is worked out from its fields, so forgetting the impl is an\nerror wherever `Send` is asked for and not a quiet default. The impl is checked against the fields:\n\n<!-- ubel-test: run -->\n```ubel\nstruct Job { id: int, name: string }\n\nimpl Send for Job {\n}\n\nfn main() {\n    let job = Job { id = 1, name = \"index\" }\n    println(job.name)\n}\n```\n\n`impl Send for Job` is accepted because every field of `Job` is `Send`. A field that is not, such as\na `Shared<int>`, makes the impl an error (`TYPE-145`) that names the field:\n\n<!-- ubel-test: error TYPE-145 -->\n```ubel\nstruct Holder { cell: Shared<int> }\n\nimpl Send for Holder {\n}\n\nfn main() {\n}\n```\n\nA type that is safe to send in spite of what the compiler can see takes `unsafe impl Send for Holder\n{}`. That impl is trusted and not checked, so it is the one place a data race can be introduced, and\n`unsafe` makes it easy to find. `unsafe impl` is for `Send` and `Sync` only.\n\nA built-in type needs no impl and cannot be given one. Numbers, `bool`, `char` and `string` have both\nmarkers. A tuple, an optional, a `List`, a `Dictionary` and the other collections have a marker when\nevery part has it. `Unique<T>` has what `T` has, and `SyncShared<T>` has both when `T` is `Send`.\n`Shared<T>`, references, borrowed views, function values and tasks have neither. A generic function\nasks for a marker with a bound, `fn run<T: Send>(x: T)`, and a generic type makes its impl\nconditional, `impl<T: Send> Send for Box<T> {}`.\n\nThe compiler does not yet refuse a value that is not `Send` at `Task.spawn`: that check is the next\nstep. Until then a closure, a `Shared`, a task or a pool is still refused when the task starts.\n\n## The decided design")
    patch_replace_text("web/site/src/project-status.md", "`UBEL_WORKERS` sets the worker count. Next: the\n  sharing rule and the lock types", "`UBEL_WORKERS` sets the worker count. `Send` and `Sync` exist\n  as marker traits with checked impls and `unsafe impl` (2026-11-24); nothing enforces them at\n  `Task.spawn` yet. Next: the send flag on tasks and a real `SyncShared`, then the lock types")
    patch_replace_text("README.md", "The sharing rule, locks, channels, atomics, scopes and cancellation are", "`Send` and `Sync` as marker traits with checked impls and `unsafe impl` are **Working** too, but nothing\nenforces them at `Task.spawn` yet. The rest of the sharing rule, locks, channels, atomics, scopes and\ncancellation are")
)
