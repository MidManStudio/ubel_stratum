// Not supported: a HIGH function with no arena open calling a MID function that allocates in its caller's arena
// (here `make`, which builds a struct). There is no arena to pass (D10, stage 1).
// expect-refusal: allocates in its caller's arena
struct P {
    x: int
}

@tier(mid)
fn make(a: int) int {
    let p = P { x = a }
    return p.x
}

fn main() void {
    println(make(1))
}
