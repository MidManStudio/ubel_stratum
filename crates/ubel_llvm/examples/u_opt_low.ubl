// Not supported: `first` on a list of numbers in a `@tier(low)` function. The optional result is a GC box, which LOW
// must not allocate.
// expect-refusal: `first` on a list of numbers or bools
fn make() List<int> {
    let xs: List<int> = List.new()
    xs.push(3)
    return xs
}

@tier(low)
fn head(xs: List<int>) int {
    let v = xs.first() or return -1
    return v
}

fn main() void {
    println(head(make()))
}
