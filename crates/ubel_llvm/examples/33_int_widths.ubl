// Every integer operator at every width, with the awkward values: MIN / -1, shifts at and beyond the width,
// negative shift amounts, and wraparound. The interpreter is the oracle. (`int` is 64-bit; only small values
// are used for it, because the interpreter does plain `int` arithmetic through f64 above 2^53.)

fn ops_i8(a: i8, b: i8) void {
    println("i8", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
    println(-a, -b)
}

fn ops_i16(a: i16, b: i16) void {
    println("i16", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
    println(-a, -b)
}

fn ops_i32(a: i32, b: i32) void {
    println("i32", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
    println(-a, -b)
}

fn ops_int(a: int, b: int) void {
    println("int", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
    println(-a, -b)
}

fn ops_u8(a: u8, b: u8) void {
    println("u8", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
}

fn ops_u16(a: u16, b: u16) void {
    println("u16", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
}

fn ops_u32(a: u32, b: u32) void {
    println("u32", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
}

fn ops_u64(a: u64, b: u64) void {
    println("u64", a, b)
    println(a + b, a - b, a * b, a / b, a % b)
    println(a & b, a | b, a ^ b, ~a, a << b, a >> b)
    println(a < b, a <= b, a > b, a >= b, a == b, a != b)
}

fn main() void {
    ops_i8(-127 - 1, -1)
    ops_i8(127, 1)
    ops_i8(-127 - 1, 1)
    ops_i8(127, 127)
    ops_i8(7, -2)
    ops_i8(-7, 2)
    ops_i8(-1, 7)
    ops_i8(1, 8)
    ops_i8(1, 9)
    ops_i8(-8, -1)
    ops_i8(100, 27)
    ops_i8(-127 - 1, 127)
    ops_i8(127, 127 - 1)
    ops_i16(-32767 - 1, -1)
    ops_i16(32767, 1)
    ops_i16(-32767 - 1, 1)
    ops_i16(32767, 32767)
    ops_i16(7, -2)
    ops_i16(-7, 2)
    ops_i16(-1, 15)
    ops_i16(1, 16)
    ops_i16(1, 17)
    ops_i16(-8, -1)
    ops_i16(100, 27)
    ops_i16(-32767 - 1, 32767)
    ops_i16(32767, 32767 - 1)
    ops_i32(-2147483647 - 1, -1)
    ops_i32(2147483647, 1)
    ops_i32(-2147483647 - 1, 1)
    ops_i32(2147483647, 2147483647)
    ops_i32(7, -2)
    ops_i32(-7, 2)
    ops_i32(-1, 31)
    ops_i32(1, 32)
    ops_i32(1, 33)
    ops_i32(-8, -1)
    ops_i32(100, 27)
    ops_i32(-2147483647 - 1, 2147483647)
    ops_i32(2147483647, 2147483647 - 1)
    ops_int(7, -2)
    ops_int(-7, 2)
    ops_int(100, 27)
    ops_int(1, 63)
    ops_int(1, 64)
    ops_int(1, 65)
    ops_int(-8, -1)
    ops_int(-1, 5)
    ops_int(12345, 678)
    ops_int(0 - 3, 3)
    ops_u8(255, 1)
    ops_u8(0, 255)
    ops_u8(255, 255)
    ops_u8(128, 2)
    ops_u8(1, 7)
    ops_u8(1, 8)
    ops_u8(1, 9)
    ops_u8(255, 3)
    ops_u8(200, 100)
    ops_u8(7, 2)
    ops_u8(255 - 1, 255)
    ops_u16(65535, 1)
    ops_u16(0, 65535)
    ops_u16(65535, 65535)
    ops_u16(32768, 2)
    ops_u16(1, 15)
    ops_u16(1, 16)
    ops_u16(1, 17)
    ops_u16(65535, 3)
    ops_u16(200, 100)
    ops_u16(7, 2)
    ops_u16(65535 - 1, 65535)
    ops_u32(4294967295, 1)
    ops_u32(0, 4294967295)
    ops_u32(4294967295, 4294967295)
    ops_u32(2147483648, 2)
    ops_u32(1, 31)
    ops_u32(1, 32)
    ops_u32(1, 33)
    ops_u32(4294967295, 3)
    ops_u32(200, 100)
    ops_u32(7, 2)
    ops_u32(4294967295 - 1, 4294967295)
    ops_u64(18446744073709551615, 1)
    ops_u64(0, 18446744073709551615)
    ops_u64(18446744073709551615, 18446744073709551615)
    ops_u64(9223372036854775808, 2)
    ops_u64(1, 63)
    ops_u64(1, 64)
    ops_u64(1, 65)
    ops_u64(18446744073709551615, 3)
    ops_u64(200, 100)
    ops_u64(7, 2)
    ops_u64(18446744073709551615 - 1, 18446744073709551615)
}
