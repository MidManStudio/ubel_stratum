// A reference to an enum (`&Shape`) as a parameter, `&x` of an enum as an argument, and a reference passed on to another
// function. A reference to an enum is the enum's own pointer, as a reference to a struct is.
enum Shape {
    Circle(int)
    Square(int)
    Unit
}

fn area(s: &Shape) int {
    match s {
        Shape.Circle(r) => 3 * r * r
        Shape.Square(w) => w * w
        Shape.Unit => 1
    }
}

fn double_area(s: &Shape) int {
    return area(s) * 2
}

fn main() void {
    let a = Shape.Circle(2)
    let b = Shape.Square(3)
    let u = Shape.Unit
    println(area(&a))
    println(area(&b))
    println(double_area(&u))
    println(double_area(&a))
}
