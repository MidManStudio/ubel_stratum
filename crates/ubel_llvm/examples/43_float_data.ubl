// double and float inside data: struct fields (GC heap and arena), enum payloads, parameters, results, captured
// closure values, and enough allocation to make the collector run while they are live (a float field is not a
// pointer, and a double whose bits look like an address must not keep anything alive or be changed). The
// interpreter is the oracle.

struct Particle {
    x:   double
    v:   double
    m:   float
    tag: int
}

struct Sensor {
    last:  Reading
    scale: double
    name:  string
}

enum Reading {
    Temp(double),
    Pair(float, double),
    Count(int),
    Empty,
}

struct Cell {
    a: float
    b: double
    c: float
}

fn step(p: Particle, dt: double) {
    p.x += p.v * dt
    p.v = p.v * 0.99
}

fn energy(p: Particle) double {
    return 0.5 * (p.m as double) * p.v * p.v
}

fn value(r: Reading) double {
    match r {
        Reading.Temp(t) => return t,
        Reading.Pair(a, b) => return (a as double) + b,
        Reading.Count(n) => return n as double,
        Reading.Empty => return -1.0,
    }
}

fn make_scaler(k: double) fn(double) double {
    return fn(x: double) x * k
}

fn make_mix(a: float, b: double) fn(double) double {
    return fn(x: double) x * b + (a as double)
}

fn apply(f: fn(double) double, x: double) double {
    return f(f(x))
}

fn churn(n: int) double {
    let mut total = 0.0
    for i in 0 .. n {
        let p = Particle { x = i as double, v = 0.5, m = 2.0f, tag = i }
        step(p, 0.25)
        total += p.x + energy(p)
    }
    return total
}

fn make_reading(i: int) Reading {
    if i % 3 == 0 {
        return Reading.Temp(i as double / 4.0)
    }
    if i % 3 == 1 {
        return Reading.Pair(0.5f, 1.25)
    }
    return Reading.Count(i)
}

fn readings(n: int) double {
    let mut total = 0.0
    for i in 0 .. n {
        total += value(make_reading(i))
    }
    return total
}

@tier(mid)
fn in_arena(n: int) double {
    with arena(512) {
        let mut total = 0.0
        for i in 0 .. n {
            let c = Cell { a = 1.5f, b = i as double * 0.1, c = 0.25f }
            c.b += 1.0
            total += (c.a as double) + c.b + (c.c as double)
        }
        return total
    }
}

fn main() void {
    let p = Particle { x = 1.0, v = 2.0, m = 3.0f, tag = 7 }
    step(p, 0.5)
    step(p, 0.5)
    println(p.x, p.v, p.m, p.tag, energy(p))
    let s = Sensor { last = Reading.Pair(1.5f, 2.5), scale = 0.1, name = "probe" }
    println(s.scale, s.name, value(s.last), value(Reading.Temp(36.6)), value(Reading.Count(3)), value(Reading.Empty))
    let double_it = make_scaler(2.0)
    let third = make_scaler(1.0 / 3.0)
    let mix = make_mix(0.5f, 4.0)
    println(double_it(1.25), third(1.0), mix(2.0), apply(double_it, 0.1), apply(third, 1.0), apply(mix, 1.0))
    println(churn(10), churn(1000), churn(200000))
    println(readings(10), readings(30000))
    println(in_arena(5), in_arena(50000))
    let c = Cell { a = 0.1f, b = 0.1, c = 0.1f }
    println(c.a, c.b, c.c, (c.a as double) == c.b)
    println($"{p.x} {p.m} {s.scale} {c.a}")
}
