// Not supported yet: string `+` in a LOW function. The result is always allocated in the GC heap, and LOW
// must not allocate there.
// expect-refusal: string `+` in `@tier(low)`
@tier(low)
fn join(a: string, b: string) int {
    let c = a + b
    return 1
}

fn main() void {
    println(join("a", "b"))
}
