// Not supported: a HIGH function with no arena open calling a MID function that allocates in its caller's arena
// (here `tidy`, whose string method builds a string). There is no arena to pass (D10, stage 1).
// expect-refusal: allocates in its caller's arena
@tier(mid)
fn tidy(s: string) int {
    return s.trim().len()
}

fn main() void {
    println(tidy("  hi  "))
}
