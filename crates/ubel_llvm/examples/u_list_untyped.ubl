// Not supported yet: a `List.new()` whose element type the emitter cannot see where it is written. Sema leaves it
// unsolved (`List<?T>`) until the list is used, so the place it is stored in has to name the type.
// expect-refusal: the element type is not known here
fn main() void {
    let xs = List.new()
    xs.push(1)
    println(xs.len())
}
