// Not supported: a HIGH function with no arena open calling a MID function that allocates in its caller's arena
// (here `run`, which creates a capturing closure). There is no arena to pass (D10, stage 1).
// expect-refusal: allocates in its caller's arena
@tier(mid)
fn run(k: int) int {
    let f = fn(x: int) x + k
    return f(1)
}

fn main() void {
    println(run(2))
}
