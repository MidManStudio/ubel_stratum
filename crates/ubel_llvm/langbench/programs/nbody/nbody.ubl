// n-body: advance five bodies (the Sun and the four gas giants) @N@ steps of 0.01 and print the energy
// before and after, times 1e9, truncated to an integer. Same algorithm as the Computer Language
// Benchmarks Game problem of this name, written for this repo.

struct Body {
    x:    double
    y:    double
    z:    double
    vx:   double
    vy:   double
    vz:   double
    mass: double
}

fn solar_mass() double {
    return 4.0 * 3.141592653589793 * 3.141592653589793
}

fn body(x: double, y: double, z: double, vx: double, vy: double, vz: double, mass: double) Body {
    let dpy = 365.24
    let sm = solar_mass()
    return Body { x = x, y = y, z = z, vx = vx * dpy, vy = vy * dpy, vz = vz * dpy, mass = mass * sm }
}

fn advance(bodies: List<Body>, dt: double) void {
    let n = bodies.len()
    for i in 0 .. n {
        let bi = bodies[i]
        for j in (i + 1) .. n {
            let bj = bodies[j]
            let dx = bi.x - bj.x
            let dy = bi.y - bj.y
            let dz = bi.z - bj.z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * sqrt(d2))
            bi.vx -= dx * bj.mass * mag
            bi.vy -= dy * bj.mass * mag
            bi.vz -= dz * bj.mass * mag
            bj.vx += dx * bi.mass * mag
            bj.vy += dy * bi.mass * mag
            bj.vz += dz * bi.mass * mag
        }
    }
    for i in 0 .. n {
        let b = bodies[i]
        b.x += dt * b.vx
        b.y += dt * b.vy
        b.z += dt * b.vz
    }
}

fn energy(bodies: List<Body>) double {
    let n = bodies.len()
    let mut e = 0.0
    for i in 0 .. n {
        let bi = bodies[i]
        e += 0.5 * bi.mass * (bi.vx * bi.vx + bi.vy * bi.vy + bi.vz * bi.vz)
        for j in (i + 1) .. n {
            let bj = bodies[j]
            let dx = bi.x - bj.x
            let dy = bi.y - bj.y
            let dz = bi.z - bj.z
            e -= bi.mass * bj.mass / sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    return e
}

fn offset_momentum(bodies: List<Body>) void {
    let mut px = 0.0
    let mut py = 0.0
    let mut pz = 0.0
    for i in 0 .. bodies.len() {
        let b = bodies[i]
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    }
    let sun = bodies[0]
    let sm = solar_mass()
    sun.vx = 0.0 - px / sm
    sun.vy = 0.0 - py / sm
    sun.vz = 0.0 - pz / sm
}

fn main() void {
    let bodies: List<Body> = List.new()
    bodies.push(Body { x = 0.0, y = 0.0, z = 0.0, vx = 0.0, vy = 0.0, vz = 0.0, mass = solar_mass() })
    bodies.push(body(4.84143144246472090, -1.16032004402742839, -0.103622044471123109, 1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05, 9.54791938424326609e-04))
    bodies.push(body(8.34336671824457987, 4.12479856412430479, -0.403523417114321381, -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05, 2.85885980666130812e-04))
    bodies.push(body(12.8943695621391310, -15.1111514016986312, -0.223307578892655734, 2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05, 4.36624404335156298e-05))
    bodies.push(body(15.3796971148509165, -25.9193146099879641, 0.179258772950371181, 2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05, 5.15138902046611451e-05))
    offset_momentum(bodies)
    println((energy(bodies) * 1000000000.0) as int)
    let steps = @N@
    for s in 0 .. steps {
        advance(bodies, 0.01)
    }
    println((energy(bodies) * 1000000000.0) as int)
}
