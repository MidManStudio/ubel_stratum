// fannkuch-redux: over all permutations of 1..@N@, flip the first k cards (k = the first card) until card 1
// is first. Prints the checksum (the flip counts, signed by the permutation's parity) and the maximum flips.
// Same algorithm as the Computer Language Benchmarks Game problem of this name, written for this repo.

fn main() void {
    let n = @N@
    let perm1: List<int> = List.new()
    let perm: List<int> = List.new()
    let count: List<int> = List.new()
    for i in 0 .. n {
        perm1.push(i)
        perm.push(0)
        count.push(0)
    }
    let mut max_flips = 0
    let mut perm_count = 0
    let mut checksum = 0
    let mut r = n
    let mut running = true
    while running {
        while r != 1 {
            count[r - 1] = r
            r -= 1
        }
        for i in 0 .. n {
            perm[i] = perm1[i]
        }
        let mut flips = 0
        let mut k = perm[0]
        while k != 0 {
            let mut i = 0
            let mut j = k
            while i < j {
                let t = perm[i]
                perm[i] = perm[j]
                perm[j] = t
                i += 1
                j -= 1
            }
            flips += 1
            k = perm[0]
        }
        if flips > max_flips {
            max_flips = flips
        }
        if perm_count % 2 == 0 {
            checksum += flips
        } else {
            checksum -= flips
        }
        let mut more = true
        while more {
            if r == n {
                running = false
                more = false
            } else {
                let p0 = perm1[0]
                let mut i = 0
                while i < r {
                    perm1[i] = perm1[i + 1]
                    i += 1
                }
                perm1[r] = p0
                count[r] -= 1
                if count[r] > 0 {
                    more = false
                } else {
                    r += 1
                }
            }
        }
        perm_count += 1
    }
    println(checksum)
    println(max_flips)
}
