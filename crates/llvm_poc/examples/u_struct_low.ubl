// Not supported yet: a struct literal in a LOW function. How LOW allocates is undecided
// (`Unique.new` passes sema but the interpreter cannot read a field through it).
// expect-refusal: @tier(low)
struct P {
    x: int
}

@tier(low)
fn make(a: int) int {
    let p = P { x = a }
    return p.x
}

fn main() void {
    println(make(1))
}
