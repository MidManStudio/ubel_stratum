// Not supported on purpose: a string method that builds a new string (`to_upper`, `to_lower`, `trim`,
// `trim_start`, `trim_end`, `replace`) in a LOW function. The result is a new GC string, and LOW must not
// allocate in the GC heap (string `+` is refused there for the same reason). In HIGH and inside
// `with arena` they work (30_string_build).
// expect-refusal: in `@tier(low)` (it allocates in the GC heap, which LOW must not)
@tier(low)
fn shout(s: string) int {
    return s.to_upper().len()
}

fn main() void {
    println(shout("hello"))
}
