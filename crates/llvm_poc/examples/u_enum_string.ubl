// Not supported yet: `match` on an integer. The emitter matches on enum and string values only. (The file
// name is historical: it used to test `match` on a string, which works now, see 28_string_match.)
// expect-refusal: `match` on anything but an enum or a string value
fn kind(n: int) int {
    return match n {
        1 => 10,
        2 => 20,
        _ => 0,
    }
}

fn main() void {
    println(kind(1), kind(9))
}
