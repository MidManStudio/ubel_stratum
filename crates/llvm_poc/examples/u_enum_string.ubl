// Not supported yet: `match` on a string. The emitter matches on enum values only. (The file name is
// historical: strings in enum payloads work now, see 19_strings and 25_arena_scan.)
// expect-refusal: `match` on anything but an enum value
fn kind(s: string) int {
    return match s {
        "a" => 1,
        "b" => 2,
        _ => 0,
    }
}

fn main() void {
    println(kind("a"), kind("z"))
}
