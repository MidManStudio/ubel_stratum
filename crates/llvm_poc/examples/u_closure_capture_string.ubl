// Not supported yet: comparing two closures with `==`. A closure value is a pointer to its object and
// closures have no equality in the emitter. (The file name is historical: closures capture strings now,
// see 25_arena_scan.)
// expect-refusal: operators on closure values
fn main() void {
    let f = fn(x: int) x + 1
    let g = fn(x: int) x + 1
    println(f == g)
}
