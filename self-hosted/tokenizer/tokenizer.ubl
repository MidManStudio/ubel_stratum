enum TokenKind {
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Colon,
    Comma,
    StringLit,
    NumberLit,
    TrueLit,
    FalseLit,
    NullLit,
    Eof,
    Invalid
}

struct Token {
    kind: TokenKind,
    str_val: Str,
    num_val: double
}

fn is_digit(ch: int) bool {
    return (ch >= 48) and (ch <= 57)
}

fn is_whitespace(ch: int) bool {
    return (ch == 32) or (ch == 9) or (ch == 10) or (ch == 13)
}

fn tokenize(raw_ascii: List<int>) List<Token> {
    let mut tokens: List<Token> = List.new()
    let len = raw_ascii.len()
    let mut i = 0

    while (i < len) {
        let ch = raw_ascii[i]

        if (is_whitespace(ch) == true) {
            i = i + 1
            continue
        }

        if (ch == 123) {
            let t = Token { kind = TokenKind.LBrace, str_val = "{", num_val = 0.0 }
            tokens.push(t)
            i = i + 1
            continue
        }

        if (ch == 125) {
            let t = Token { kind = TokenKind.RBrace, str_val = "}", num_val = 0.0 }
            tokens.push(t)
            i = i + 1
            continue
        }

        if (ch == 91) {
            let t = Token { kind = TokenKind.LBracket, str_val = "[", num_val = 0.0 }
            tokens.push(t)
            i = i + 1
            continue
        }

        if (ch == 93) {
            let t = Token { kind = TokenKind.RBracket, str_val = "]", num_val = 0.0 }
            tokens.push(t)
            i = i + 1
            continue
        }

        if (ch == 58) {
            let t = Token { kind = TokenKind.Colon, str_val = ":", num_val = 0.0 }
            tokens.push(t)
            i = i + 1
            continue
        }

        if (ch == 44) {
            let t = Token { kind = TokenKind.Comma, str_val = ",", num_val = 0.0 }
            tokens.push(t)
            i = i + 1
            continue
        }

        if (ch == 34) {
            i = i + 1
            while ((i < len) and (raw_ascii[i] != 34)) {
                i = i + 1
            }

            if ((i >= len) == true) {
                let err_tok = Token { kind = TokenKind.Invalid, str_val = "Unterminated String", num_val = 0.0 }
                tokens.push(err_tok)
                return tokens
            }

            let str_tok = Token { kind = TokenKind.StringLit, str_val = "parsed_str", num_val = 0.0 }
            tokens.push(str_tok)
            i = i + 1
            continue
        }

        if (is_digit(ch) or (ch == 45)) {
            let mut num_accum: double = 0.0
            let mut is_negative = false

            if (ch == 45) {
                is_negative = true
                i = i + 1
            }

            while ((i < len) and (is_digit(raw_ascii[i]) == true)) {
                let digit_val: double = (raw_ascii[i] - 48) as double
                num_accum = (num_accum * 10.0) + digit_val
                i = i + 1
            }

            if (is_negative == true) {
                num_accum = 0.0 - num_accum
            }

            let num_tok = Token { kind = TokenKind.NumberLit, str_val = "", num_val = num_accum }
            tokens.push(num_tok)
            continue
        }

        let inv_tok = Token { kind = TokenKind.Invalid, str_val = "Unexpected Character", num_val = 0.0 }
        tokens.push(inv_tok)
        i = i + 1
    }

    let eof_tok = Token { kind = TokenKind.Eof, str_val = "EOF", num_val = 0.0 }
    tokens.push(eof_tok)
    return tokens
}
